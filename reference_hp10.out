#   mset =  1

x: Energy [MeV]
y: Flux [1/cm^2/source]              
p: xlin ylog afac(0.8) form(0.9)
h: n            x            y(neutron ),hh0l n  
#  e-lower      e-upper        neutron   r.err 
   0.0000E+00   2.0000E+01   5.5103E+03  0.0002

#   sum over                 5.5103E+03  0.0002

'no. =  1,  reg =    100,  mset =   1'
msuc: {\huge True Hp(10) Reference Dose}
msdr: {\it plotted by \ANGEL \version}
msdl: {\it calculated by \PHITS  3.35}
wt: s(0.7)
\vspace{-3}
   vol  &=&   1.0000E+00 [cm^3]
  mset  &=&   1
e:
 
